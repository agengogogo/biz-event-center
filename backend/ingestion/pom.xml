<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.park.eventcenter</groupId>
        <artifactId>biz-event-center-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ingestion</artifactId>
    <name>ingestion</name>
    <description>Multi-source event ingestion, validation, dedup and standardization</description>

    <dependencies>
        <dependency>
            <groupId>com.park.eventcenter</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.park.eventcenter</groupId>
            <artifactId>event-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.park.eventcenter</groupId>
            <artifactId>store-query</artifactId>
        </dependency>
        <dependency>
            <groupId>com.park.eventcenter</groupId>
            <artifactId>dispatch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.2</version>
            <exclusions>
                <!-- Optional validators we do not use; keep the runtime light. -->
                <exclusion>
                    <groupId>org.jruby.joni</groupId>
                    <artifactId>joni</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.graalvm.js</groupId>
                    <artifactId>js</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.graalvm.sdk</groupId>
                    <artifactId>graal-sdk</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
